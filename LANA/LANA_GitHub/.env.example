# Copy this file to .env and fill in only the settings you use.

# Spotify (optional)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# L.A.N.A. Mobile
LANA_MOBILE_PORT=8765
LANA_MOBILE_TOKEN=
# Optional private Tailscale IP. Never commit your real value.
LANA_TAILSCALE_IP=

# Local AI / camera
OLLAMA_HOST=http://127.0.0.1:11434
LANA_CAMERA_INDEX=0
LANA_WEBCAM_MODEL=gemma4:e4b

# Optional weather/location configuration
LANA_ZIP_CODE=

# Optional local music folder
LANA_MUSIC_FOLDER=
